# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# The public HTTPS URL where Instagram Graph API can reach your images.
# For local development, use an ngrok tunnel (e.g. https://abc123.ngrok-free.app)
PUBLIC_BASE_URL=http://localhost:3000

# ==========================================
# LOCAL SQLITE DATABASES
# ==========================================
KJV_DB_PATH=./data/kjv.db
TAMIL_DB_PATH=./data/tamil.db

# ==========================================
# GOOGLE GEMINI & IMAGEN API
# ==========================================
# Get your API key free from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Background Image Provider: 'imagen' (uses Gemini), 'dalle' (uses OpenAI), or 'mock' (offline demo)
IMAGE_PROVIDER=imagen
OPENAI_API_KEY=

# ==========================================
# INSTAGRAM GRAPH API
# ==========================================
# Meta Developer App -> Graph API Explorer -> Instagram Account ID & Token
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ==========================================
# AUTOMATION (NODE-CRON)
# ==========================================
# Daily at 08:00 AM (Sec Min Hour Day Month DayOfWeek)
CRON_SCHEDULE="0 8 * * *"
AUTO_PUBLISH_ON_CRON=false
CRON_LANGUAGE=both
